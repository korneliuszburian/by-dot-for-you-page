---
import "../css/global.css";
import { ClientRouter } from "astro:transitions";
import { shellVideoUrl } from "../utils/shell-media";
import { siteMetadata } from "../utils/site-metadata";

interface Props {
  title: string;
  description?: string;
  backgroundVideoFilter?: string;
}

const {
  title,
  description = siteMetadata.defaultDescription,
  backgroundVideoFilter,
} = Astro.props;

const canonicalUrl = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : undefined;
---

<!doctype html>
<html
  lang={siteMetadata.locale}
  transition:name="root"
  transition:animate="fade"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index,follow" />

    <meta name="theme-color" content={siteMetadata.themeColor} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={siteMetadata.name} />
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl.href} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl.href} />}

    <title>{title}</title>

    <ClientRouter />
  </head>
  <body>
    <video
      class="background__video"
      autoplay
      muted
      loop
      playsinline
      transition:persist
    >
      <source src={shellVideoUrl} type="video/mp4" />
      Your browser does not support the video tag.
    </video>
    <slot />
    <style define:vars={{ backgroundVideoFilter }}>
      .background__video {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -1;
        filter: var(--backgroundVideoFilter, none);
      }
    </style>
    <style is:global>
      @keyframes product-zoom-out {
        from {
          opacity: 1;
          transform: scale(1);
        }
        to {
          opacity: 0;
          transform: scale(0.8);
        }
      }
      @keyframes product-zoom-in {
        from {
          opacity: 0;
          transform: scale(1.2);
        }
        to {
          opacity: 1;
          transform: scale(1);
        }
      }
      [data-astro-transition="back"] .hero-image {
        animation: product-zoom-out 0.2s ease-out forwards;
      }
      [data-astro-transition="forward"] .hero-image {
        animation: product-zoom-in 0.2s ease-out forwards;
      }
    </style>
  </body>
</html>
