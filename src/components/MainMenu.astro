---
import { mainMenuItems } from "../utils/site-navigation";
---

<main class="entrance">
  <div class="entrance__shade" aria-hidden="true"></div>
  <section class="entrance__panel" aria-labelledby="site-name">
    <header class="entrance__brand">
      <img class="entrance__logo" src="/YOU_logo.png" alt="YOU" />
      <p id="site-name">BY DOT FOR YOU</p>
    </header>
    <div class="entrance__divider" aria-hidden="true"><span>✣</span></div>
    <nav aria-label="Main navigation">
      <ul class="entrance__menu">
        {
          mainMenuItems.map((item, index) => (
            <li>
              {item.status === "active" && item.route ? (
                <a class:list={{ "is-default": index === 0 }} href={item.route}>
                  <span class="entrance__cursor" aria-hidden="true">
                    ◆
                  </span>
                  {item.title}
                </a>
              ) : (
                <span class="entrance__disabled" aria-disabled="true">
                  <span class="entrance__cursor" aria-hidden="true">
                    ◆
                  </span>
                  {item.title}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <footer class="entrance__footer">
      <div
        class="entrance__divider entrance__divider--footer"
        aria-hidden="true"
      >
        <span>✣</span>
      </div>
      <p>
        <strong>ENTER</strong> to enter <span>·</span>
        <strong>ESC</strong> to leave
      </p>
      <span class="entrance__signature">.DOT</span>
    </footer>
  </section>
</main>

<style>
  .entrance {
    box-sizing: border-box;
    min-height: 100svh;
    position: relative;
    display: grid;
    align-items: center;
    padding: clamp(1rem, 4vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }
  .entrance__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(
        circle at 65% 45%,
        transparent 0 18%,
        rgb(0 4 8 / 0.12) 52%,
        rgb(0 2 5 / 0.78) 100%
      ),
      linear-gradient(90deg, rgb(0 2 5 / 0.42), transparent 62%);
    pointer-events: none;
  }
  .entrance__panel {
    width: min(24rem, calc(100vw - 2rem));
    min-height: min(43rem, calc(100svh - 2rem));
    margin-left: clamp(0rem, 20vw, 19rem);
    display: flex;
    flex-direction: column;
    padding: clamp(1.8rem, 4vh, 2.8rem) clamp(2rem, 4vw, 3rem) 1.25rem;
    color: #e8d6a9;
    background: linear-gradient(145deg, rgb(3 6 9 / 0.91), rgb(4 7 10 / 0.76));
    border: 1px solid #9b6d18;
    box-shadow:
      inset 0 0 0 1px rgb(240 185 66 / 0.12),
      0 0 0 1px rgb(0 0 0 / 0.8),
      0 1.5rem 4rem rgb(0 0 0 / 0.45);
    animation: panel-enter 0.8s cubic-bezier(0.2, 0.75, 0.25, 1) both;
  }
  .entrance__brand {
    text-align: center;
  }
  .entrance__logo {
    display: block;
    width: min(13rem, 75%);
    height: 10rem;
    object-fit: contain;
    margin: -0.6rem auto 0.55rem;
    mix-blend-mode: screen;
    filter: contrast(1.2) brightness(1.12);
  }
  .entrance__brand p {
    margin: 0;
    color: #d7b56c;
    font-family: var(--font-title, Cinzel, serif);
    font-size: 0.8rem;
    letter-spacing: 0.22em;
  }
  .entrance__divider {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 1.55rem 0 1.35rem;
    color: #8c8a80;
    font-size: 0.72rem;
  }
  .entrance__divider::before,
  .entrance__divider::after {
    content: "";
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, rgb(176 151 96 / 0.45));
  }
  .entrance__divider::after {
    transform: scaleX(-1);
  }
  .entrance__menu {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.55rem;
  }
  .entrance__menu a,
  .entrance__disabled {
    position: relative;
    display: block;
    padding-left: 2.9rem;
    color: #d7c69d;
    font-family: var(--font-title, Cinzel, serif);
    font-size: clamp(1rem, 1.35vw, 1.2rem);
    letter-spacing: 0.075em;
    line-height: 1.45;
    text-decoration: none;
    text-shadow: 0 2px 3px #000;
    transition:
      color 0.16s ease,
      transform 0.16s ease,
      text-shadow 0.16s ease;
  }
  .entrance__disabled {
    color: #777166;
    cursor: not-allowed;
  }
  .entrance__cursor {
    position: absolute;
    left: 0.55rem;
    top: 0.12em;
    opacity: 0;
    color: #e8c678;
    font-size: 0.72em;
    transform: rotate(45deg) scale(0.8);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease;
  }
  .entrance__menu a.is-default .entrance__cursor,
  .entrance__menu a:hover .entrance__cursor,
  .entrance__menu a:focus-visible .entrance__cursor {
    opacity: 1;
    transform: rotate(45deg) scale(1);
  }
  .entrance__menu a:hover,
  .entrance__menu a:focus-visible {
    color: #fff0c7;
    transform: translateX(0.2rem);
    text-shadow: 0 0 12px rgb(213 165 66 / 0.5);
    outline: none;
  }
  .entrance__menu:has(a:hover) a.is-default:not(:hover) .entrance__cursor,
  .entrance__menu:has(a:focus-visible)
    a.is-default:not(:focus-visible)
    .entrance__cursor {
    opacity: 0;
  }
  .entrance__footer {
    margin-top: auto;
    position: relative;
    text-align: center;
  }
  .entrance__divider--footer {
    margin: 1.3rem 0 0.85rem;
  }
  .entrance__footer p {
    margin: 0;
    color: #b9a77e;
    font-family: ui-monospace, "Courier New", monospace;
    font-size: 0.7rem;
    letter-spacing: 0.05em;
  }
  .entrance__footer strong {
    color: #ddc38d;
    font-weight: 500;
  }
  .entrance__footer p span {
    margin: 0 0.35rem;
  }
  .entrance__signature {
    position: absolute;
    right: -0.9rem;
    bottom: -0.2rem;
    color: #d6b968;
    font-family: var(--font-title, Cinzel, serif);
    font-size: 0.75rem;
  }
  @keyframes panel-enter {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }
  @media (max-width: 760px) {
    .entrance {
      place-items: center;
      padding: 1rem;
    }
    .entrance__panel {
      margin-left: 0;
      min-height: calc(100svh - 2rem);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .entrance__panel,
    .entrance__menu a {
      animation: none;
      transition: none;
    }
  }
</style>
