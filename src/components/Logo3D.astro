---
/**
 * Gothic Artifact - "SOUL BURN" Edition
 * Idle: Cold, Dark Iron, High Pixelation
 * Hover: Burning Gold, Sharper Image, Faster Spin
 */

interface Props {
  class?: string;
  size?: "small" | "medium" | "large" | "full";
}

const { class: className = "", size = "medium" } = Astro.props;

const sizeClasses = {
  small: "logo-3d--small",
  medium: "logo-3d--medium",
  large: "logo-3d--large",
  full: "logo-3d--full",
};

const currentSizeClass = sizeClasses[size] || sizeClasses.medium;
---

<div data-logo-3d class={`logo-3d ${currentSizeClass} ${className}`}>
  <canvas data-logo-3d-canvas class="logo-3d__canvas"></canvas>

  <div data-logo-3d-loader class="logo-3d__loader">
    <span class="logo-3d__loader-text">Summoning...</span>
  </div>
</div>

<style>
  .logo-3d {
    position: relative;
    margin-inline: auto;
    overflow: hidden;
    cursor: pointer;
  }

  .logo-3d--small {
    width: 8rem;
    height: 8rem;
  }

  .logo-3d--medium {
    width: 100%;
    height: 300px;
  }

  .logo-3d--large {
    width: 100%;
    height: 500px;
  }

  .logo-3d--full {
    width: 100%;
    height: 100%;
  }

  .logo-3d__canvas {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
    transition: transform 700ms ease-out;
  }

  .logo-3d:hover .logo-3d__canvas {
    transform: scale(1.05);
  }

  .logo-3d__loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 10;
    transition: opacity 200ms ease;
  }

  .logo-3d__loader-text {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: #444;
    font-family: var(--font-primary);
    text-transform: uppercase;
    animation: logo-loader-pulse 1.5s ease-in-out infinite;
  }

  @keyframes logo-loader-pulse {
    0%,
    100% {
      opacity: 0.45;
    }
    50% {
      opacity: 1;
    }
  }
</style>

<script>
  const LOGO_SELECTOR = "[data-logo-3d]";
  const RUNTIME_KEY = "__byDotLogo3DRuntime";

  type Logo3DRuntime = {
    bindPageLifecycle: () => void;
    initAll: () => void;
  };

  type Logo3DModule = typeof import("../scripts/logo-3d-runtime");

  let runtimeModulePromise: Promise<Logo3DModule> | undefined;

  function loadLogo3DRuntime() {
    runtimeModulePromise ??= import("../scripts/logo-3d-runtime.ts");
    return runtimeModulePromise;
  }

  async function initArtifact(container: HTMLElement) {
    if (container.dataset.logo3dInitialized === "true") return;

    try {
      const { initLogo3DArtifact } = await loadLogo3DRuntime();
      if (!container.isConnected) return;
      initLogo3DArtifact(container);
    } catch {
      container.dataset.logo3dInitialized = "false";
      const loaderEl = container.querySelector("[data-logo-3d-loader]");
      if (loaderEl instanceof HTMLElement) {
        loaderEl.textContent = "Failed to summon";
      }
    }
  }

  function queueArtifactInit(container: HTMLElement) {
    if (container.dataset.logo3dBound === "true") return;
    container.dataset.logo3dBound = "true";

    let started = false;
    let observer: IntersectionObserver | undefined;

    const start = () => {
      if (started) return;
      started = true;
      observer?.disconnect();
      void initArtifact(container);
    };

    container.addEventListener("mouseenter", start, { once: true });
    container.addEventListener("focusin", start, { once: true });
    container.addEventListener("touchstart", start, {
      once: true,
      passive: true,
    });

    if ("IntersectionObserver" in window) {
      observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              start();
              break;
            }
          }
        },
        { rootMargin: "200px 0px" },
      );

      observer.observe(container);
      return;
    }

    start();
  }

  function createRuntime(): Logo3DRuntime {
    let lifecycleBound = false;

    return {
      bindPageLifecycle() {
        if (lifecycleBound) return;
        lifecycleBound = true;

        document.addEventListener("astro:page-load", () => {
          this.initAll();
        });
      },
      initAll() {
        document.querySelectorAll<HTMLElement>(LOGO_SELECTOR).forEach((node) => {
          queueArtifactInit(node);
        });
      },
    };
  }

  const runtimeWindow = window as unknown as Window &
    Record<string, Logo3DRuntime | undefined>;
  const runtime = (runtimeWindow[RUNTIME_KEY] ??= createRuntime());

  runtime.bindPageLifecycle();
  runtime.initAll();
</script>
