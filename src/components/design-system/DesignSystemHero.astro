---
import Logo3D from "../Logo3D.astro";

export interface Props {
  eyebrow: string;
  title: string;
  intro: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="design-system-hero">
  <div class="design-system-hero__logo">
    <Logo3D size="small" />
  </div>
  <div class="design-system-hero__copy">
    <p class="design-system-eyebrow">{eyebrow}</p>
    <h1 class="design-system-title">{title}</h1>
    <p class="design-system-intro">{intro}</p>
  </div>
</section>

<style>
  .design-system-hero {
    display: grid;
    grid-template-columns: minmax(180px, 240px) 1fr;
    gap: var(--space-l);
    align-items: center;
  }

  .design-system-hero__logo {
    display: flex;
    justify-content: center;
  }

  .design-system-eyebrow {
    margin: 0 0 var(--space-2xs) 0;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.75;
  }

  .design-system-title {
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.4rem);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow:
      0 0 20px rgba(255, 153, 0, 0.25),
      2px 2px 0 rgba(10, 10, 10, 0.9);
  }

  .design-system-intro {
    margin: var(--space-xs) 0 0 0;
    max-width: 65ch;
    line-height: 1.6;
    color: rgba(245, 245, 220, 0.9);
  }

  @media (max-width: 960px) {
    .design-system-hero {
      grid-template-columns: 1fr;
    }
  }
</style>
