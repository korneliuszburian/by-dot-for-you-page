---
import Layout from "../layouts/Layout.astro";
import GothicButton from "../components/GothicButton.astro";
import GothicFrame from "../components/GothicFrame.astro";
import { routeCatalog } from "../utils/site-navigation";
import { getCollections } from "../utils/products-dataset";

const collections = getCollections();
---

<Layout title={routeCatalog.collections.pageTitle}>
  <main class="collections-page">
    <section class="collections-page__hero flow">
      <p class="collections-page__eyebrow">Collections Loader</p>
      <h1 class="collections-page__title">KOLEKCJE</h1>
      <p class="collections-page__intro">
        Ten widok nie duplikuje sklepu. Wskazuje aktywne kolekcje i przekazuje
        użytkownika do kanonicznego gridu w <code>/shop</code>.
      </p>
    </section>

    <section class="collections-grid">
      {
        collections.map((collection) => (
          <GothicFrame
            variant="ornate"
            size="medium"
            background="none"
            class="collections-card"
          >
            <div class="collections-card__content flow">
              <div class="collections-card__meta">
                <h2>{collection.name}</h2>
                <p>{collection.count} products</p>
              </div>
              <GothicButton
                href={`/shop?collection=${encodeURIComponent(collection.name)}`}
                variant="button5"
                size="medium"
              >
                Open in Shop
              </GothicButton>
            </div>
          </GothicFrame>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  .collections-page {
    min-height: 100vh;
    padding: var(--space-l);
    display: grid;
    gap: var(--space-l);
    color: var(--color-highlight-bone);
  }

  .collections-page__hero {
    justify-items: center;
    text-align: center;
  }

  .collections-page__eyebrow,
  .collections-page__title,
  .collections-page__intro {
    margin: 0;
  }

  .collections-page__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.7;
  }

  .collections-page__title {
    font-size: clamp(2.2rem, 5vw, 4rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .collections-page__intro {
    max-width: 58ch;
    line-height: 1.6;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-m);
  }

  .collections-card {
    min-height: 100%;
  }

  .collections-card__content {
    height: 100%;
    justify-items: center;
    align-content: center;
    text-align: center;
  }

  .collections-card__meta {
    display: grid;
    gap: var(--space-2xs);
  }

  .collections-card__meta h2,
  .collections-card__meta p {
    margin: 0;
  }
</style>
