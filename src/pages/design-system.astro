---
import Layout from "../layouts/Layout.astro";
import DesignSystemComponentCard from "../components/design-system/DesignSystemComponentCard.astro";
import DesignSystemDecisionsCard from "../components/design-system/DesignSystemDecisionsCard.astro";
import DesignSystemGrid from "../components/design-system/DesignSystemGrid.astro";
import DesignSystemHero from "../components/design-system/DesignSystemHero.astro";
import DesignSystemSection from "../components/design-system/DesignSystemSection.astro";
import DesignSystemTokenCard from "../components/design-system/DesignSystemTokenCard.astro";
import {
  componentCards,
  designSystemHero,
  designSystemPageMeta,
  referenceLinks,
  systemDecisions,
  tokenCards,
} from "../utils/design-system/reference-content";
---

<Layout
  title={designSystemPageMeta.title}
  description={designSystemPageMeta.description}
  backgroundVideoFilter={designSystemPageMeta.backgroundVideoFilter}
>
  <main class="design-system-page">
    <DesignSystemHero {...designSystemHero} />

    <DesignSystemSection title="Komponenty">
      <DesignSystemGrid>
        {componentCards.map((card) => <DesignSystemComponentCard {...card} />)}
      </DesignSystemGrid>
    </DesignSystemSection>

    <DesignSystemSection title="Tokeny">
      <DesignSystemGrid tokens>
        {tokenCards.map((card) => <DesignSystemTokenCard {...card} />)}
      </DesignSystemGrid>
    </DesignSystemSection>

    <DesignSystemSection title="Decyzje Systemowe">
      <DesignSystemDecisionsCard
        decisions={systemDecisions}
        links={referenceLinks}
      />
    </DesignSystemSection>
  </main>
</Layout>

<style>
  .design-system-page {
    min-height: 100vh;
    padding: var(--space-l);
    display: grid;
    gap: var(--space-l);
    color: var(--color-highlight-bone, #f5f5dc);
  }
</style>
