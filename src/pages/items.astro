---
import { canonicalCommerceRoute, routeCatalog } from "../utils/site-navigation";
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta
      http-equiv="refresh"
      content={`0;url=${canonicalCommerceRoute}`}
    />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonicalCommerceRoute} />
    <title>{routeCatalog.itemsAlias.pageTitle}</title>
  </head>
  <body>
    <p>
      Przekierowanie do <a href={canonicalCommerceRoute}>kanonicznej listy przedmiotów</a>.
    </p>
  </body>
</html>
