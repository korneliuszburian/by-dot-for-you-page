---
import Layout from "../layouts/Layout.astro";
import GothicButton from "../components/GothicButton.astro";
import Logo3D from "../components/Logo3D.astro";
import { Image } from "astro:assets";
import {
  getAllProducts,
  getCategories,
  getCategoryCounts,
  getCollections,
} from "../utils/products-dataset";

const allProducts = getAllProducts();

// Placeholder path correction
const placeholderPath = "/placeholder.webp";

// Calculate category and collection counts
const categoryCounts = getCategoryCounts(allProducts);

// Get unique categories
const categories = getCategories(allProducts);
const collections = getCollections(allProducts);
const collectionPrefilterRules = collections
  .map((collection) => {
    const collectionName = collection.name.replace(/\\/g, "\\\\").replace(/"/g, '\\"');

    return `
      :root[data-collection-filter="${collectionName}"] .shop__product-card:not([data-collection="${collectionName}"]) {
        display: none;
      }

      :root[data-collection-filter="${collectionName}"] .collection-btn {
        opacity: 0.75;
      }

      :root[data-collection-filter="${collectionName}"] .collection-btn.active,
      :root[data-collection-filter="${collectionName}"] .collection-btn[data-collection-filter="${collectionName}"] {
        opacity: 1;
      }
    `;
  })
  .join("\n");

// SEO metadata
const title = "Dot For You - Handmade Clothing Collection";
const description =
  "Handmade pants and clothing from Poland. Available in various sizes and collections.";
---

<Layout
  title={title}
  description={description}
  backgroundVideoFilter="brightness(0.7)"
>
  <script is:inline>
    const requestedCollection = new URLSearchParams(window.location.search).get(
      "collection",
    );

    if (requestedCollection) {
      document.documentElement.dataset.collectionFilter = requestedCollection;
    } else {
      delete document.documentElement.dataset.collectionFilter;
    }
  </script>

  <div class="shop-container" transition:animate="fade">
    <!-- Hero Section -->
    <section class="shop-hero">
      <div class="hero-content shop-hero__content flow">
        <a href="/" class="shop-home-link">
          <Logo3D size="small" class="shop-home-link__logo" />
          <span class="visually-hidden">Return to home</span>
        </a>
      </div>

      <section class="filters-section">
        <div class="filters-container flow flow-space-l wrapper">
          <div class="flow flow-space-xs">
            <div class="filter-group">
              <span class="filter-label">Availability:</span>
              <div class="filter-buttons">
                <GothicButton
                  variant="button5"
                  size="medium"
                  class="filter-btn active"
                  data-filter="all"
                >
                  All ({allProducts.length})
                </GothicButton>
                <GothicButton
                  variant="button5"
                  size="medium"
                  class="filter-btn"
                  data-filter="available"
                >
                  Available ({
                    allProducts.filter((p) => p.data.status === "Available")
                      .length
                  })
                </GothicButton>
                <GothicButton
                  variant="button5"
                  size="medium"
                  class="filter-btn"
                  data-filter="unavailable"
                >
                  Unavailable ({
                    allProducts.filter((p) => p.data.status === "Unavailable")
                      .length
                  })
                </GothicButton>
              </div>
            </div>

            <div class="filter-group">
              <span class="filter-label">Category:</span>
              <div class="filter-buttons">
                <GothicButton
                  variant="button5"
                  size="medium"
                  class="category-btn active"
                  data-category="all"
                >
                  All ({allProducts.length})
                </GothicButton>
                {
                  categories.map((category) => (
                    <GothicButton
                      variant="button5"
                      size="medium"
                      class="category-btn"
                      data-category={category}
                    >
                      {category} ({categoryCounts[category] || 0})
                    </GothicButton>
                  ))
                }
              </div>
            </div>

            <div class="filter-group">
              <span class="filter-label">Collection:</span>
              <div class="filter-buttons">
                <GothicButton
                  variant="button5"
                  size="medium"
                  class="collection-btn active"
                  data-collection-filter="all"
                >
                  All ({allProducts.length})
                </GothicButton>
                {
                  collections.map((collection) => (
                    <GothicButton
                      variant="button5"
                      size="medium"
                      class="collection-btn"
                      data-collection-filter={collection.name}
                    >
                      {collection.name} ({collection.count})
                    </GothicButton>
                  ))
                }
              </div>
            </div>
          </div>
          <section class="products-section">
            <div class="shop__products-grid grid" transition:animate="fade">
              {
                allProducts.map((product, index) => {
                  const isAvailable = product.data.status === "Available";

                  // Eagerly load first 6 products (above the fold), lazy load the rest
                  const loadingStrategy = index < 6 ? "eager" : "lazy";

                  // Get first image for the product
                  const hasImage = product.data.images.length > 0;

                  return (
                    <article
                      transition:animate="fade"
                      transition:name={`product-card-${product.slug}`}
                      class="shop__product-card"
                      data-status={product.data.status}
                      data-category={product.data.type}
                      data-collection={product.data.collection}
                      data-available={isAvailable ? "true" : "false"}
                    >
                      <a
                        href={`/shop/${product.slug}`}
                        class="product-link flow"
                      >
                        <div class="shop__product-image-container">
                          <div class="image-loader">
                            <div class="image-loader__spinner" />
                          </div>

                          {hasImage ? (
                            <Image
                              src={product.data.images[0]}
                              alt={product.data.product_name}
                              width={400}
                              height={400}
                              loading={loadingStrategy}
                              class="shop__product-image shop__product-image--loading"
                              transition:name={`product-image-${product.slug}`}
                              onload="this.classList.remove('shop__product-image--loading'); this.parentElement.querySelector('.image-loader').style.display='none';"
                            />
                          ) : (
                            <Image
                              src={placeholderPath}
                              alt="Image Not Available"
                              width={400}
                              height={400}
                              loading="lazy"
                              class="shop__product-image shop__product-image--loading"
                              transition:name={`product-image-${product.slug}`}
                              onload="this.classList.remove('shop__product-image--loading'); this.parentElement.querySelector('.image-loader').style.display='none';"
                            />
                          )}

                          {!isAvailable && (
                            <div class="shop__product-overlay">
                              {/* <span class="shop__overlay-text">NIEDOSTĘPNE</span> */}
                            </div>
                          )}
                        </div>
                        <div class="shop__product-info">
                          <h3 class="shop__product-name">
                            {product.data.product_name}
                          </h3>
                          <div class="shop__product-meta">
                            {/* <span class="shop__product-collection">{product.data.collection}</span> */}
                            <span class="shop__product-price">
                              {product.data.price_pln} ZŁ
                            </span>
                          </div>
                          <div class="shop__product-details">
                            <span class="shop__product-size">
                              Size: {product.data.size_eu}
                            </span>
                          </div>
                        </div>
                      </a>
                    </article>
                  );
                })
              }
            </div>

            <div class="no-results" style="display: none;">
              <p>No products found matching criteria.</p>
            </div>
          </section>
        </div>
      </section>
    </section>
  </div>
</Layout>

<style is:inline set:html={collectionPrefilterRules}></style>

<style>
  .shop-hero {
    position: relative;
    min-height: 100vh;
  }

  .shop__product-image-container img {
    height: 300px;
    width: auto;
    object-fit: contain;
  }

  /* Container styles */
  .shop__product-image-container {
    min-height: 300px; /* Reserve space */
    border-radius: 4px;
    background: transparent; /* Explicitly transparent */
  }

  .shop-container {
    min-height: 100vh;
    color: var(--color-highlight-bone);
  }

  .products-section {
    z-index: 999;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .shop-hero__content {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }

  .shop-home-link {
    display: inline-block;
  }

  .shop-home-link__logo {
    pointer-events: none;
  }

  .hero-title {
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 4px;
  }

  .filters-section {
    z-index: 10;
    padding: var(--space-m);
    position: relative;
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-items: center;
  }

  .filter-label {
    font-size: var(--size-step-00);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .filter-buttons,
  .category-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
  }

  .filter-btn.active,
  .category-btn.active,
  .collection-btn.active {
    opacity: 1;
  }

  @media (max-width: 640px) {
  }

  .shop__product-card {
    position: relative;
    transition:
      transform 0.3s,
      box-shadow 0.3s;
  }

  .shop__products-grid {
    --grid-min-item-size: 14rem;
    --gutter: 24px;
  }

  .shop__product-card.hidden {
    display: none;
  }

  .shop__product-card:hover {
    transform: translateY(-4px);
  }

  .product-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .image-loader {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 0;
  }

  .image-loader__spinner {
    width: 2rem;
    height: 2rem;
    border: 2px solid #57534e;
    border-top-color: #d6d3d1;
    border-radius: 999px;
    animation: shop-image-loader-spin 0.8s linear infinite;
  }

  .shop__product-image {
    position: relative;
    z-index: 10;
    transition: opacity 0.3s ease;
  }

  .shop__product-image--loading {
    opacity: 0;
  }

  @keyframes shop-image-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .product-image-container {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 8px;
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .product-info {
    --flow-space: var(--space-2xs);
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: center;
    text-align: center;
  }

  .product-meta {
    display: flex;
    flex-direction: column;
  }

  .shop__product-info {
    --flow-space: var(--space-2xs);
  }

  .product-name {
    font-size: var(--size-step-1);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .product-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .product-category {
    font-size: var(--size-step-00);
    color: var(--color-metal-bronze-patina);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .product-price {
    font-size: var(--size-step-1);
    font-weight: bold;
  }
</style>

<script>
  function initializeShopFilters() {
    console.log("Shop page loaded with filters");

    // Get all product cards
    const productCards = document.querySelectorAll(
      ".shop__product-card",
    ) as NodeListOf<HTMLElement>;
    const noResultsMessage = document.querySelector(
      ".no-results",
    ) as HTMLElement;

    // Filter state
    let currentAvailabilityFilter = "all";
    let currentCategoryFilter = "all";
    let currentCollectionFilter = "all";

    // Filter buttons
    const filterBtns = document.querySelectorAll(
      ".filter-btn",
    ) as NodeListOf<HTMLButtonElement>;
    const categoryBtns = document.querySelectorAll(
      ".category-btn",
    ) as NodeListOf<HTMLButtonElement>;
    const collectionBtns = document.querySelectorAll(
      ".collection-btn",
    ) as NodeListOf<HTMLButtonElement>;

    function updateActiveState(buttons: NodeListOf<HTMLButtonElement>, value: string, attribute: string) {
      buttons.forEach((button) => {
        const buttonValue = button.getAttribute(attribute) || "all";
        button.classList.toggle("active", buttonValue === value);
      });
    }

    function syncCollectionQueryParam() {
      const url = new URL(window.location.href);

      if (currentCollectionFilter === "all") {
        url.searchParams.delete("collection");
        delete document.documentElement.dataset.collectionFilter;
      } else {
        url.searchParams.set("collection", currentCollectionFilter);
        document.documentElement.dataset.collectionFilter =
          currentCollectionFilter;
      }

      window.history.replaceState({}, "", `${url.pathname}${url.search}${url.hash}`);
    }

    // Apply filters function with smooth transitions
    // Apply filters function
    function applyFilters() {
      let visibleCount = 0;

      productCards.forEach((card) => {
        const cardCategory = card.getAttribute("data-category");
        const cardCollection = card.getAttribute("data-collection");
        const cardAvailable = card.getAttribute("data-available") === "true";

        let showCard = true;

        // Availability filter
        if (currentAvailabilityFilter === "available" && !cardAvailable) {
          showCard = false;
        } else if (
          currentAvailabilityFilter === "unavailable" &&
          cardAvailable
        ) {
          showCard = false;
        }

        // Category filter
        if (
          currentCategoryFilter !== "all" &&
          cardCategory !== currentCategoryFilter
        ) {
          showCard = false;
        }

        if (
          currentCollectionFilter !== "all" &&
          cardCollection !== currentCollectionFilter
        ) {
          showCard = false;
        }

        if (showCard) {
          card.classList.remove("hidden");
          // Remove manual inline styles that might interfere
          card.style.display = "";
          visibleCount++;
        } else {
          card.classList.add("hidden");
          card.style.display = "none";
        }
      });

      // Show/hide no results message
      if (noResultsMessage) {
        if (visibleCount === 0) {
          noResultsMessage.style.display = "block";
        } else {
          noResultsMessage.style.display = "none";
        }
      }
    }

    // Filter button click handlers with view transitions
    filterBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (isTransitioning) return;

        // Update State
        filterBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentAvailabilityFilter = btn.getAttribute("data-filter") || "all";

        // Start view transition if supported
        if ("startViewTransition" in document) {
          isTransitioning = true;
          try {
            await (document as any).startViewTransition(() => {
              applyFilters();
            }).ready;
          } catch (e) {
            console.log("Transition skipped", e);
            applyFilters();
          } finally {
            isTransitioning = false;
          }
        } else {
          applyFilters();
        }
      });
    });

    // Debounce to prevent rapid clicks aborting transitions
    let isTransitioning = false;

    categoryBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (isTransitioning) return;

        // Logic to update state
        categoryBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        currentCategoryFilter = btn.getAttribute("data-category") || "all";

        // Start view transition if supported
        if ("startViewTransition" in document) {
          isTransitioning = true;
          try {
            await (document as any).startViewTransition(() => {
              applyFilters();
            }).ready;
          } catch (e) {
            // If transition aborted, ensure filters are applied
            // applyFilters() is called inside the callback, but if the browser
            // drops the transition, we might want to ensure the DOM state is final.
            // With applyFilters it's DOM manipulation, so checks are needed.
            console.log("Transition skipped or aborted", e);
            applyFilters();
          } finally {
            isTransitioning = false;
          }
        } else {
          applyFilters();
        }
      });
    });

    collectionBtns.forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (isTransitioning) return;

        currentCollectionFilter =
          btn.getAttribute("data-collection-filter") || "all";
        updateActiveState(
          collectionBtns,
          currentCollectionFilter,
          "data-collection-filter",
        );
        syncCollectionQueryParam();

        if ("startViewTransition" in document) {
          isTransitioning = true;
          try {
            await (document as any).startViewTransition(() => {
              applyFilters();
            }).ready;
          } catch (e) {
            console.log("Transition skipped or aborted", e);
            applyFilters();
          } finally {
            isTransitioning = false;
          }
        } else {
          applyFilters();
        }
      });
    });

    // Initialize with proper visibility
    productCards.forEach((card) => {
      card.style.transition = "opacity 0.3s ease, transform 0.3s ease";
      card.style.opacity = "1";
      card.style.transform = "scale(1)";
    });

    const searchParams = new URLSearchParams(window.location.search);
    const requestedCollection = searchParams.get("collection");
    const hasRequestedCollection = requestedCollection
      ? [...collectionBtns].some(
          (button) =>
            button.getAttribute("data-collection-filter") === requestedCollection,
        )
      : false;

    if (requestedCollection && hasRequestedCollection) {
      currentCollectionFilter = requestedCollection;
      updateActiveState(
        collectionBtns,
        currentCollectionFilter,
        "data-collection-filter",
      );
      document.documentElement.dataset.collectionFilter =
        currentCollectionFilter;
    } else {
      delete document.documentElement.dataset.collectionFilter;
    }

    applyFilters();

    console.log("Filters initialized with", productCards.length, "products");
  }

  document.addEventListener("DOMContentLoaded", initializeShopFilters);
  document.addEventListener("astro:page-load", initializeShopFilters);
</script>
