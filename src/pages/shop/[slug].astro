---
import productsData from "../../../public/dataset/output.json";
import Layout from "../../layouts/Layout.astro";
import GothicButton from "../../components/GothicButton.astro";
import GothicFrame from "../../components/GothicFrame.astro";
import Logo3D from "../../components/Logo3D.astro";
import { Image } from "astro:assets";
import type { GetStaticPaths } from "astro";

// Generate static paths for all products
export const getStaticPaths = (async () => {
  return productsData.map((product) => {
    const slug = `${product.product_name.toLowerCase().replace(/\s+/g, "-")}-${product.id}`;
    return {
      params: { slug },
      props: {
        product: {
          ...product,
          slug,
          data: {
            ...product,
            images: product.images.map((img) => {
              if (img.startsWith("/")) return img;
              const cleanPath = img
                .replace(/^Items\//, "")
                .replace(/\/Website\//, "/");
              return `/dataset/database/${cleanPath}`;
            }),
          },
        },
      },
    };
  });
}) satisfies GetStaticPaths;

// Get product from props
const { product } = Astro.props;

// If product not found (shouldn't happen with static paths, but for safety)
if (!product) {
  return Astro.redirect("/shop");
}

// Product data from JSON
const productData = product.data;
const isAvailable = productData.status === "Available";

// Features (already an array in JSON, but just in case it's a string or needs joining)
const features = Array.isArray(productData.website_des)
  ? productData.website_des
  : productData.website_des
    ? [productData.website_des]
    : [];
---

<Layout
  title={`${productData.product_name} - Dot For You`}
  description={`Handmade ${productData.product_name} by Dawid Olek. ${productData.fabric}. ${productData.website_des}`}
  backgroundVideoFilter="brightness(0.3)"
>
  <div class="product-screen relative">
    <!-- Floating Home Logo -->
    <a
      href="/"
      class="absolute top-6 left-6 z-50 block drop-shadow-[0_0_15px_rgba(255,60,0,0.3)] hover:drop-shadow-[0_0_25px_rgba(255,60,0,0.6)] transition-all duration-300"
    >
      <Logo3D size="small" class="pointer-events-none" />
      <span class="sr-only">Return to home</span>
    </a>

    <!-- Main game-style container -->
    <div class="inventory-panel">
      <!-- Left Column: Item Display -->
      <div class="item-display">
        <GothicFrame
          variant="ornate"
          size="thick"
          background="none"
          class="item-frame"
        >
          <div class="item-showcase">
            {
              productData.images.length > 0 ? (
                <div class="relative w-full h-full flex items-center justify-center">
                  <div class="image-loader absolute inset-0 flex items-center justify-center pointer-events-none z-0">
                    <div class="w-8 h-8 border-2 border-stone-600 border-t-stone-300 rounded-full animate-spin" />
                  </div>
                  <Image
                    src={productData.images[0]}
                    alt={productData.product_name}
                    width={500}
                    height={500}
                    loading="eager"
                    class="item-image relative z-10 transition-opacity duration-500 opacity-0"
                    transition:name={`product-image-${product.slug}`}
                    onload="this.classList.remove('opacity-0'); this.parentElement.querySelector('.image-loader').style.display='none';"
                  />
                </div>
              ) : (
                <Image
                  src="/placeholder.webp"
                  alt={`${productData.product_name} - Image Not Available`}
                  width={500}
                  height={500}
                  loading="lazy"
                  class="item-image"
                />
              )
            }
          </div>
        </GothicFrame>

        <!-- Thumbnail gallery below main image -->
        {
          productData.images.length > 1 && (
            <div class="gallery-strip">
              {productData.images.map((image: string, index: number) => (
                <button
                  class={`thumb ${index === 0 ? "active" : ""}`}
                  data-image={image}
                  data-index={index}
                >
                  <Image
                    src={image}
                    alt={`View ${index + 1}`}
                    width={60}
                    height={60}
                    loading="lazy"
                  />
                </button>
              ))}
            </div>
          )
        }
      </div>

      <!-- Right Column: Stats Panel -->
      <div class="stats-panel">
        <GothicFrame
          variant="ornate"
          size="thick"
          background="none"
          class="stats-frame"
        >
          <div class="stats-content">
            <!-- Item Name Header -->
            <header class="item-header">
              <span class="collection-badge">{productData.collection}</span>
              <h1 class="item-name">{productData.product_name}</h1>
              <div class="item-type">{productData.type}</div>
            </header>

            <!-- Stats Grid -->
            <div class="stats-grid">
              <div class="stat-row">
                <span class="stat-label">Size</span>
                <span class="stat-value">{productData.size_eu}</span>
              </div>
              <div class="stat-row">
                <span class="stat-label">Fabric</span>
                <span class="stat-value">{productData.fabric}</span>
              </div>
              <div class="stat-row">
                <span class="stat-label">Edition</span>
                <span class="stat-value stat-rare">1 of 1</span>
              </div>
            </div>

            <!-- Features List (like skill list in RPG) -->
            <div class="features-section">
              {
                features.length > 0 && (
                  <>
                    <h3 class="section-title">Features</h3>
                    <ul class="features-list">
                      {features.map((feature: string) => (
                        <li class="feature-item">
                          <span class="feature-icon">◆</span>
                          {feature}
                        </li>
                      ))}
                    </ul>
                  </>
                )
              }

              {/* Care Instructions */}
              {
                productData.care_instruction &&
                  productData.care_instruction.length > 0 && (
                    <div
                      class="care-section"
                      style="margin-top: var(--space-s);"
                    >
                      <h3 class="section-title">Care</h3>
                      <ul class="features-list">
                        {Array.isArray(productData.care_instruction) ? (
                          productData.care_instruction.map(
                            (instruction: string) => (
                              <li class="feature-item">
                                <span class="feature-icon">◆</span>
                                {instruction}
                              </li>
                            ),
                          )
                        ) : (
                          <li class="feature-item">
                            <span class="feature-icon">◆</span>
                            {productData.care_instruction}
                          </li>
                        )}
                      </ul>
                    </div>
                  )
              }
            </div>

            <!-- Measurements Table -->
            <div
              class="measurements-section"
              style="margin-top: var(--space-s);"
            >
              <h3 class="section-title">Measurements</h3>
              <div class="measurements-grid">
                <div class="measurement-row">
                  <span class="measurement-label">Waist (A)</span>
                  <span class="measurement-value"
                    >{productData.size_a_waist}</span
                  >
                </div>
                <div class="measurement-row">
                  <span class="measurement-label">Length (B)</span>
                  <span class="measurement-value"
                    >{productData.size_b_length}</span
                  >
                </div>
                <div class="measurement-row">
                  <span class="measurement-label">Leg Opening (C)</span>
                  <span class="measurement-value"
                    >{productData.size_c_leg_opening}</span
                  >
                </div>
                <div class="measurement-row">
                  <span class="measurement-label">Inseam (D)</span>
                  <span class="measurement-value"
                    >{productData.size_d_inseam}</span
                  >
                </div>
              </div>
            </div>

            <!-- Price Display (like gold in inventory) -->
            <div class="price-display">
              <span class="price-amount">{productData.price_pln}</span>
              <span class="price-currency">ZŁ</span>
            </div>

            <!-- Action Button -->
            <div class="action-area">
              {
                isAvailable ? (
                  <GothicButton
                    variant="button5"
                    size="medium"
                    class="action-btn"
                    data-open-popup="true"
                  >
                    Contact Us
                  </GothicButton>
                ) : (
                  <GothicButton
                    variant="button4"
                    size="medium"
                    class="action-btn sold-out"
                    disabled
                  >
                    Sold Out
                  </GothicButton>
                )
              }
            </div>
          </div>
        </GothicFrame>

        <!-- Footer info -->
        <div class="panel-footer">
          <span class="maker">By Dawid Olek</span>
          <a href="/shop" class="back-link">← Back</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Popup -->
  <div class="contact-popup" id="contact-popup">
    <div class="contact-popup__overlay" id="popup-overlay"></div>
    <div class="contact-popup__container">
      <GothicFrame
        variant="ornate"
        size="thick"
        background="none"
        class="contact-popup__frame"
      >
        <div class="contact-popup__content">
          <video
            class="contact-popup__video"
            autoplay
            loop
            muted
            playsinline
            poster="/assets/videos/testing-video-poster-02.png"
          >
            <source
              src="/assets/videos/testing-video-02.mp4"
              type="video/mp4"
            />
          </video>

          <div class="contact-popup__inner">
            <h2 class="contact-popup__title">DM ME</h2>
            <p class="contact-popup__subtitle">
              {productData.product_name} - {productData.price_pln} ZŁ
            </p>

            <div class="contact-popup__options">
              <GothicButton
                variant="button4"
                size="medium"
                href={`mailto:kontakt@dotforyou.pl?subject=Inquiry: ${productData.product_name}`}
                class="contact-popup__option"
              >
                Email
              </GothicButton>

              <GothicButton
                variant="button4"
                size="medium"
                href="https://instagram.com/dotforyou"
                class="contact-popup__option contact-popup__instagram"
              >
                Instagram
              </GothicButton>

              <GothicButton
                variant="button4"
                size="medium"
                class="contact-popup__close"
                data-close-popup="true"
              >
                Close
              </GothicButton>
            </div>
          </div>
        </div>
      </GothicFrame>
    </div>
  </div>
</Layout>

<style>
  /* ===== FULL VIEWPORT LOCK ===== */
  .product-screen {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    justify-content: stretch;
    box-sizing: border-box;
  }

  /* ===== MAIN INVENTORY PANEL ===== */
  .inventory-panel {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    width: 100%;
    height: 100%;
    align-items: stretch;
    padding: var(--space-m);
    box-sizing: border-box;
  }

  /* ===== LEFT: ITEM DISPLAY ===== */
  .item-display {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    height: 100%;
  }

  .item-frame {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 0;
  }

  .item-showcase {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-m);
    background: transparent;
    z-index: 0;
  }

  .item-image {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 4px;
    position: relative;
    z-index: 1; /* Above skeleton */
  }

  /* Gallery thumbnails strip */
  .gallery-strip {
    display: flex;
    gap: var(--space-2xs);
    justify-content: center;
    flex-shrink: 0;
  }

  .thumb {
    width: 50px;
    height: 50px;
    padding: 2px;
    background: rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.2);
    cursor: pointer;
    transition: all 0.2s ease;
    overflow: hidden;
  }

  .thumb:hover,
  .thumb.active {
    border-color: var(--color-metal-antique-gold);
    box-shadow: 0 0 10px rgba(212, 175, 55, 0.3);
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ===== RIGHT: STATS PANEL ===== */
  .stats-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    height: 100%;
  }

  .stats-frame {
    flex: 1;
    min-height: 0;
    overflow: hidden;
  }

  .stats-content {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: var(--space-m);
    gap: var(--space-s);
    color: white;
    scrollbar-width: thin;
    scrollbar-color: var(--color-metal-antique-gold) transparent;
  }

  /* Item Header */
  .item-header {
    text-align: center;
    padding-bottom: var(--space-s);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .collection-badge {
    display: inline-block;
    font-size: var(--size-step-00);
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--color-metal-antique-gold);
    opacity: 0.8;
  }

  .item-name {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 4px;
    margin: var(--space-2xs) 0;
    color: var(--color-highlight-bone);
    line-height: 1.2;
  }

  .item-type {
    font-size: var(--size-step-00);
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Stats Grid (like character stats) */
  .stats-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .stat-row {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2xs) 0;
    border-bottom: 1px dotted rgba(255, 255, 255, 0.1);
  }

  .stat-label {
    font-size: var(--size-step-00);
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .stat-value {
    font-size: var(--size-step-0);
    color: var(--color-highlight-bone);
  }

  .stat-rare {
    color: var(--color-metal-antique-gold);
    text-shadow: 0 0 8px rgba(212, 175, 55, 0.5);
  }

  /* Features Section */
  .features-section {
    flex: 1;
    min-height: 0;
  }

  .section-title {
    font-size: var(--size-step-00);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: var(--space-xs);
    color: var(--color-metal-antique-gold);
    opacity: 0.9;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .feature-item {
    font-size: var(--size-step-0);
    display: flex;
    align-items: flex-start;
    gap: var(--space-2xs);
    line-height: 1.4;
  }

  .feature-icon {
    color: var(--color-metal-antique-gold);
    font-size: 0.6em;
    margin-top: 0.4em;
    flex-shrink: 0;
  }

  /* Measurements Grid */
  .measurements-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xs) var(--space-m);
    background: rgba(0, 0, 0, 0.2);
    padding: var(--space-xs);
    border: 1px solid rgba(255, 255, 255, 0.05);
  }

  .measurement-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .measurement-label {
    font-size: 0.75rem;
    opacity: 0.6;
    text-transform: uppercase;
  }

  .measurement-value {
    font-family: var(--font-mono);
    color: var(--color-highlight-bone);
    font-size: 0.85rem;
  }

  /* Price Display (gold-style) */
  .price-display {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-xs);
    padding: var(--space-s) 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .price-amount {
    font-size: clamp(1.5rem, 4vw, 2.5rem);
    font-weight: 300;
    color: var(--color-metal-antique-gold);
    text-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
    letter-spacing: 2px;
  }

  .price-currency {
    font-size: var(--size-step-0);
    opacity: 0.7;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  /* Action Area */
  .action-area {
    margin-top: auto;
    flex-shrink: 0;
  }

  .action-btn {
    width: 100%;
  }

  .sold-out :global(.gothic-button__content) {
    opacity: 0.5;
  }

  /* Panel Footer */
  .panel-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-2xs) var(--space-xs);
    flex-shrink: 0;
  }

  .maker {
    font-size: 0.75rem;
    opacity: 0.5;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  .back-link {
    font-size: 0.8rem;
    text-decoration: none;
    opacity: 0.6;
    color: var(--color-highlight-bone);
    transition: opacity 0.2s;
  }

  .back-link:hover {
    opacity: 1;
  }

  /* ===== MOBILE RESPONSIVE ===== */
  @media (max-width: 900px) {
    .product-screen {
      position: relative;
      width: 100%;
      max-width: 100%; /* Force constraint */
      height: auto;
      overflow-y: auto;
      overflow-x: hidden; /* Strict overflow hiding */
      padding: 0;
      margin: 0;
      min-height: 100vh;
      box-sizing: border-box;
    }

    .inventory-panel {
      display: flex; /* Switch to flex column to avoid grid blowout */
      flex-direction: column;
      height: auto;
      width: 100%;
      max-width: 100vw; /* Ensure no blowout */
      box-sizing: border-box;
      gap: var(--space-s);
      min-height: 100vh;
      padding-top: 80px;
      overflow-x: hidden; /* Double safety */
    }

    .item-display {
      width: 100%;
      height: auto;
      aspect-ratio: auto; /* Remove aspect ratio constraint */
      min-width: 0; /* Flex blowout fix */
    }

    .item-frame {
      min-height: 400px;
      width: 100%;
      box-sizing: border-box;
    }

    .stats-panel {
      width: 100%;
      height: auto;
      min-width: 0; /* Flex blowout fix */
    }

    .stats-frame {
      overflow: visible;
      height: auto;
      width: 100%;
      box-sizing: border-box;
    }

    .stats-content {
      height: auto;
      overflow: visible;
      width: 100%;
      box-sizing: border-box;
    }

    /* Hide scrollbar potential weirdness */
    .stats-content::-webkit-scrollbar {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .product-screen {
      padding: 0;
    }

    .inventory-panel {
      min-height: 100vh;
      height: auto;
      padding: var(--space-s);
      padding-top: 80px;
    }

    .item-frame {
      min-height: 300px;
    }

    .item-name {
      font-size: 1.1rem;
      letter-spacing: 2px;
    }

    .gallery-strip {
      display: none;
    }
  }

  /* ===== CONTACT POPUP ===== */
  .contact-popup {
    --flow-space: 0px;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .contact-popup.active {
    display: flex;
    opacity: 1;
  }

  .contact-popup__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    z-index: -1;
  }

  .contact-popup__container {
    position: relative;
    max-width: 500px;
    width: 90vw;
    animation: popupEntrance 0.5s ease-out;
  }

  @keyframes popupEntrance {
    from {
      opacity: 0;
      transform: translateY(30px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .contact-popup__frame {
    position: relative;
    overflow: hidden;
  }

  .contact-popup__content {
    position: relative;
    padding: var(--space-xl) var(--space-m);
  }

  .contact-popup__video {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
    opacity: 0.6;
  }

  .contact-popup__inner {
    position: relative;
    z-index: 1;
  }

  .contact-popup__title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 3px;
    margin: 0 0 var(--space-2xs) 0;
    text-align: center;
    color: var(--color-highlight-bone);
    text-shadow: 2px 2px 0 var(--color-shadow-deep);
  }

  .contact-popup__subtitle {
    font-size: var(--size-step-0);
    margin: 0 0 var(--space-l) 0;
    text-align: center;
    color: var(--color-metal-antique-gold);
    letter-spacing: 1px;
  }

  .contact-popup__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .contact-popup__option,
  .contact-popup__close {
    width: 100%;
  }

  .contact-popup__instagram :global(a) {
    pointer-events: auto;
  }
</style>

<script>
  // Image gallery functionality
  function initializeGallery() {
    const thumbnails = document.querySelectorAll(".thumb");
    const heroImage = document.querySelector(".item-image") as HTMLImageElement;

    thumbnails.forEach((thumbnail) => {
      thumbnail.addEventListener("click", () => {
        const newImage = thumbnail.getAttribute("data-image");
        if (newImage && heroImage) {
          heroImage.src = newImage;
          // Update active state
          thumbnails.forEach((t) => t.classList.remove("active"));
          thumbnail.classList.add("active");
        }
      });
    });
  }

  // Contact popup functionality
  function initializeContactPopup() {
    const openBtn = document.querySelector(".action-btn:not(.sold-out)");
    const popup = document.querySelector("#contact-popup");
    const overlay = document.querySelector("#popup-overlay");
    const closeBtn = document.querySelector(".contact-popup__close");

    if (openBtn && popup && overlay && closeBtn) {
      const openPopup = (e: Event) => {
        e.preventDefault();
        popup.classList.add("active");
        document.body.style.overflow = "hidden";
      };

      const closePopup = (e?: Event) => {
        if (e) e.preventDefault();
        popup.classList.remove("active");
        document.body.style.overflow = "";
      };

      const openBtnElement = openBtn.querySelector("button, a") || openBtn;
      const closeBtnElement = closeBtn.querySelector("button, a") || closeBtn;

      openBtnElement.addEventListener("click", openPopup);
      closeBtnElement.addEventListener("click", closePopup);
      overlay.addEventListener("click", () => closePopup());

      const handleEscape = (e: KeyboardEvent) => {
        if (e.key === "Escape" && popup.classList.contains("active")) {
          closePopup();
        }
      };

      document.addEventListener("keydown", handleEscape);
    }
  }

  // Run on initial page load
  document.addEventListener("DOMContentLoaded", () => {
    initializeGallery();
    initializeContactPopup();
  });

  // Re-run after View Transitions navigation
  document.addEventListener("astro:page-load", () => {
    initializeGallery();
    initializeContactPopup();
  });
</script>
